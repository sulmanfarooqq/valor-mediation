# Environment Configuration for Hostinger Deployment
# Copy this file to your Hostinger server as .env

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=production
APP_NAME=Valor Mediation, LLC
APP_URL=https://yourdomain.com

# ============================================
# DATABASE CONFIGURATION
# Get these from Hostinger cPanel > MySQL Databases
# ============================================
DB_HOST=<YOUR_HOSTINGER_MYSQL_HOST>
DB_PORT=3306
DB_USER=<YOUR_DATABASE_USER>
DB_PASSWORD=<YOUR_DATABASE_PASSWORD>
DB_NAME=<YOUR_DATABASE_NAME>

# ============================================
# SESSION SECURITY
# Generate a random string - keep it secret!
# ============================================
SESSION_SECRET=<GENERATE_RANDOM_STRING_32_CHARS_MIN>

# ============================================
# ADMIN CREDENTIALS
# Change these to your preferred credentials
# ============================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<YOUR_SECURE_PASSWORD>

# ============================================
# EMAIL CONFIGURATION
# Option 1: Gmail (recommended)
# Option 2: Your domain email via Hostinger
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# INSTRUCTIONS FOR SETUP
# ============================================
# 1. Get Hostinger MySQL Host from cPanel sidebar "MySQL Databases"
# 2. Generate secure PASSWORD with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. For Gmail: Use App Password (2FA enabled), NOT regular password
# 4. UPDATE all <VALUES> above with your actual credentials
# 5. Upload to root directory of your Node.js app on Hostinger
# 6. Set proper file permissions: chmod 600 .env
# 7. Restart Node.js app in Hostinger cPanel
