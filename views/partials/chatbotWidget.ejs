<!-- Valor Mediation Chatbot Widget -->
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* Toggle Button */
  #chat-toggle {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0a1628, #1a2d5a);
    border: 2px solid #c9a84c;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(10,22,40,0.45);
    z-index: 9999;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  #chat-toggle:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 28px rgba(201,168,76,0.35);
  }
  #chat-toggle svg { width: 28px; height: 28px; }
  #chat-toggle svg path { fill: #c9a84c; }

  /* Notification dot */
  #notif-dot {
    position: absolute;
    top: 6px; right: 6px;
    width: 12px; height: 12px;
    background: #e74c3c;
    border-radius: 50%;
    border: 2px solid #fff;
  }

  /* Chat Window */
  #chat-window {
    position: fixed;
    bottom: 104px;
    right: 28px;
    width: 370px;
    max-height: 560px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 12px 48px rgba(10,22,40,0.38);
    display: none;
    flex-direction: column;
    z-index: 9998;
    border: 1.5px solid #c9a84c;
    animation: slideUp 0.25s ease;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Header */
  .chat-header {
    background: linear-gradient(135deg, #0a1628 0%, #1a2d5a 100%);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1.5px solid #c9a84c;
  }
  .header-avatar {
    width: 42px; height: 42px;
    border-radius: 50%;
    background: #c9a84c;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; font-weight: 700; color: #0a1628;
    flex-shrink: 0;
  }
  .header-info h3 {
    color: #c9a84c;
    font-size: 15px; font-weight: 700; line-height: 1.2;
  }
  .header-info p {
    color: #8fa8d0;
    font-size: 12px; margin-top: 2px;
  }
  .online-dot {
    width: 8px; height: 8px;
    background: #2ecc71;
    border-radius: 50%;
    display: inline-block;
    margin-right: 4px;
  }
  .close-btn {
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    color: #8fa8d0;
    font-size: 20px;
    line-height: 1;
    padding: 4px;
    transition: color 0.2s;
  }
  .close-btn:hover { color: #c9a84c; }

  /* Messages area */
  #chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px 14px;
    background: #f7f9fc;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 360px;
    min-height: 220px;
  }
  #chat-messages::-webkit-scrollbar { width: 4px; }
  #chat-messages::-webkit-scrollbar-thumb { background: #c9a84c55; border-radius: 4px; }

  /* Bubbles */
  .msg {
    display: flex;
    flex-direction: column;
    max-width: 88%;
  }
  .msg.bot { align-self: flex-start; }
  .msg.user { align-self: flex-end; }

  .bubble {
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 13.5px;
    line-height: 1.55;
  }
  .msg.bot .bubble {
    background: linear-gradient(135deg, #0a1628, #1a2d5a);
    color: #e8eef8;
    border-bottom-left-radius: 4px;
    border: 1px solid #c9a84c44;
  }
  .msg.user .bubble {
    background: #c9a84c;
    color: #0a1628;
    font-weight: 600;
    border-bottom-right-radius: 4px;
  }
  .msg-time {
    font-size: 10.5px;
    color: #aab;
    margin-top: 3px;
    padding: 0 4px;
  }
  .msg.user .msg-time { text-align: right; }

  /* Quick replies */
  #quick-replies {
    padding: 8px 14px 4px;
    background: #f7f9fc;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .qr-btn {
    background: #fff;
    border: 1.5px solid #c9a84c;
    color: #0a1628;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
    white-space: nowrap;
  }
  .qr-btn:hover {
    background: #c9a84c;
    color: #0a1628;
  }

  /* Input area */
  .chat-footer {
    background: #fff;
    border-top: 1.5px solid #e0e7ef;
    padding: 10px 12px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  #chat-input {
    flex: 1;
    border: 1.5px solid #d0dae8;
    border-radius: 22px;
    padding: 9px 15px;
    font-size: 13.5px;
    outline: none;
    color: #0a1628;
    background: #f7f9fc;
    transition: border 0.2s;
  }
  #chat-input:focus { border-color: #c9a84c; background: #fff; }
  #send-btn {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0a1628, #1a2d5a);
    border: 2px solid #c9a84c;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.15s;
    flex-shrink: 0;
  }
  #send-btn:hover { transform: scale(1.08); }
  #send-btn svg { width: 17px; height: 17px; }
  #send-btn svg path { fill: #c9a84c; }

  /* Typing indicator */
  .typing-bubble {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 10px 14px;
    background: linear-gradient(135deg, #0a1628, #1a2d5a);
    border-radius: 14px;
    border-bottom-left-radius: 4px;
    border: 1px solid #c9a84c44;
    width: fit-content;
  }
  .typing-dot {
    width: 7px; height: 7px;
    background: #c9a84c;
    border-radius: 50%;
    animation: bounce 1.1s infinite;
  }
  .typing-dot:nth-child(2) { animation-delay: 0.18s; }
  .typing-dot:nth-child(3) { animation-delay: 0.36s; }
  @keyframes bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.7; }
    40% { transform: translateY(-6px); opacity: 1; }
  }

  /* Powered by */
  .powered {
    text-align: center;
    font-size: 10.5px;
    color: #aab;
    padding: 6px 0 8px;
    background: #fff;
  }
  .powered span { color: #c9a84c; font-weight: 600; }

  @media (max-width: 420px) {
    #chat-window { width: calc(100vw - 16px); right: 8px; bottom: 90px; }
    #chat-toggle { right: 16px; bottom: 16px; }
  }
</style>

<!-- Toggle Button -->
<button id="chat-toggle" onclick="toggleChat()" title="Chat with us">
  <div id="notif-dot"></div>
  <div style="font-size: 20px; color: #c9a84c;">💬</div>
</button>

<!-- Chat Window -->
<div id="chat-window">

  <!-- Header -->
  <div class="chat-header">
    <div class="header-avatar">V</div>
    <div class="header-info">
      <h3>Valor Mediation</h3>
      <p><span class="online-dot"></span>We're online — Ask us anything</p>
    </div>
    <button class="close-btn" onclick="toggleChat()">&#x2715;</button>
  </div>

  <!-- Messages -->
  <div id="chat-messages"></div>

  <!-- Quick Replies -->
  <div id="quick-replies">
    <button class="qr-btn" onclick="sendQuick('What services do you offer?')">Services</button>
    <button class="qr-btn" onclick="sendQuick('How do I schedule a consultation?')">Free Consultation</button>
    <button class="qr-btn" onclick="sendQuick('What is mediation?')">What is Mediation?</button>
    <button class="qr-btn" onclick="sendQuick('Service areas')">Service Areas</button>
    <button class="qr-btn" onclick="sendQuick('Contact information')">Contact Us</button>
  </div>

  <!-- Input -->
  <div class="chat-footer">
    <input id="chat-input" type="text" placeholder="Type your message..." onkeydown="handleKey(event)" />
    <button id="send-btn" onclick="sendMessage()">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 21l21-9L2 3v7l15 2-15 2z"/>
      </svg>
    </button>
  </div>

  <div class="powered">Powered by <span>Valor Mediation, LLC</span></div>
</div>

<script>
