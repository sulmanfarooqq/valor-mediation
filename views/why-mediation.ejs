        </div>
        <h3>Flexible Scheduling</h3>
        <p>Evening and weekend appointments available to fit your schedule.</p>
      </div>

      <!-- 5. Virtual Mediation -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"/>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
          </svg>
        </div>
        <h3>Advanced Virtual Mediation</h3>
        <p>Secure Zoom sessions allow participation from anywhere with complete confidentiality.</p>
      </div>

      <!-- 6. Emotionally Intelligent -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <h3>Emotionally Intelligent Mediation</h3>
        <p>We understand the human side of conflict and guide conversations with professionalism and care.</p>
      </div>

    </div>
  </div>
</section>

    <!-- Why Choose Valor Mediation -->
   

