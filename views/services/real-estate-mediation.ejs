<section class="service-page">
  <div class="container">
    
    <!-- Hero Section with Image -->
    <div class="service-hero">
      <div class="service-hero-content">
        <span class="eyebrow">Real Estate Mediation</span>
        <h1>Real Estate & Property Mediation Services</h1>
        <p class="subtitle">Resolve Property Disputes Quickly, Privately & Without Court</p>
        <p class="lead">At Valor Mediation, LLC, we provide professional real estate and property mediation services in Texas and nationwide, helping property owners, landlords, tenants, and real estate professionals resolve disputes efficiently - without the cost and delays of litigation.</p>
        <a href="/contact" class="btn">Schedule Free Consultation</a>
