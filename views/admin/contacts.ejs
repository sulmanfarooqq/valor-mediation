<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Messages | Valor Mediation, LLC</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <%- include('../partials/header') %>
  
  <div class="admin-container">
    <div class="admin-header">
      <h1>Contact Messages</h1>
      <div class="admin-header-actions">
        <a href="/admin">Dashboard</a>
        <a href="/admin/logout">Logout</a>
      </div>
    </div>
    
    <div class="admin-content">
      <table class="admin-table">
        <thead>
          <tr><th>Name</th><th>Email</th><th>Company</th><th>Date</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% contacts.forEach(contact => { %>
            <tr>
              <td><%= contact.name %></td>
              <td><%= contact.email %></td>
              <td><%= contact.company || '' %></td>
              <td><%= new Date(contact.createdAt).toLocaleDateString() %></td>
              <td>
                <a href="/admin/contacts/view/<%= contact._id %>">View</a> |
                <form action="/admin/contacts/delete/<%= contact._id %>" method="POST" style="display:inline;">
                  <button type="submit" onclick="return confirm('Delete this message?')">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  
  <script src="/js/main.js"></script>
</body>
</html>